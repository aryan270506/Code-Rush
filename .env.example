# ==============================================================================
# CODE BATTLE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT:
# - Client-side variables (prefixed with VITE_) are bundled into frontend assets.
#   NEVER put backend secrets, service keys, or private API keys here.
# - Cloud Functions and backend secrets should be placed in functions/.env
#   or configured using Firebase Secrets: `firebase functions:secrets:set SECRET_NAME`
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND: Firebase Client Configuration (Web App)
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> SDK setup
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=code-battle-hackathon.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://code-battle-hackathon-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=code-battle-hackathon
VITE_FIREBASE_STORAGE_BUCKET=code-battle-hackathon.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Enable Firebase Local Emulators in development (true/false)
VITE_USE_FIREBASE_EMULATOR=false
VITE_EMULATOR_AUTH_HOST=localhost:9099
VITE_EMULATOR_FIRESTORE_HOST=localhost:8080
VITE_EMULATOR_FUNCTIONS_HOST=localhost:5001
VITE_EMULATOR_RTDB_HOST=localhost:9000

# ------------------------------------------------------------------------------
# BACKEND: Cloud Functions, Code Execution & AI Configuration
# (Store in functions/.env or Firebase Secrets)
# ------------------------------------------------------------------------------
# JDoodle Code Execution API (https://www.jdoodle.com/compiler-api/)
JDOODLE_CLIENT_ID=your_jdoodle_client_id_here
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret_here

# Groq AI API Key (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Transactional Email Provider (Resend API Key: https://resend.com)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Verified sender email address (Must be configured in your domain on Resend)
EMAIL_FROM=Code Battle <no-reply@codebattle.dev>

# Production application URL for redirects and email branding
FRONTEND_URL=https://codebattle.dev
